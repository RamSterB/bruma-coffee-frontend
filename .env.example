# URL base de la API. Se usa como target del proxy /api de Vite en desarrollo.
# host.docker.internal resuelve al host (Docker Desktop) donde se publica el backend.
VITE_API_URL=http://host.docker.internal:8000

# Origen publico de la API, y se compila dentro del bundle. **Vacio en desarrollo.**
#
# En desarrollo la peticion va a `/api` y la traduce el proxy de arriba, asi que aqui no
# hay que poner nada. En produccion la tienda y la API estan en dominios distintos: sin
# esta variable, las peticiones terminarian en la pagina que sirve la tienda y el
# cliente recibiria HTML donde esperaba JSON.
VITE_API_ORIGIN=